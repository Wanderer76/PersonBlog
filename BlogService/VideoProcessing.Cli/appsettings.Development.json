{
  "Seq": {
    "OtlpMetricsEndpoint": "http://localhost:5341/ingest/otlp/v1/metrics"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Seq" ],
    "MinimumLevel": "Information",
    "Properties": { "Application": "VideoProcessing.Cli" },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "File", "Args": { "path": "C:\\logs\\PersonBlog\\video-processing.txt", "rollingInterval": "Day", "retainedFileCountLimit": 7, "shared": true } },
      { "Name": "Seq", "Args": { "serverUrl": "http://localhost:5341" } }
    ]
  },
  "FileStorageOptions": {
    "Endpoint": "127.0.0.1:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin"
  },
  "TempDir": "../../tmp",
  "FFMpegOptions": {
    "FFMpeg": {
      "DefaultEncoder": "h264_nvenc", //"h264_nvenc";//"libx264"; //h264_nvenc - nvidia, h264_qsv - intel, h264_amf - amd 
      "FFMpegPath": "C:\\ffmpeg\\ffmpeg.exe",
      "FFProbePath": "C:\\ffmpeg\\ffprobe.exe",
      "TempPath": "../../tmp",
      "CommandTimeoutSeconds": 7200
    },
    "HlsVideoPresets": {
      "EncodePreset": "fast",
      "VideoPresets": [
        {
          "width": 1920,
          "height": 1080,
          "videoBitrate": "5M",
          "audioBitrate": "96k"
        },
        {
          "width": 1280,
          "height": 720,
          "videoBitrate": "3M",
          "audioBitrate": "96k"
        },
        {
          "width": 854,
          "height": 480,
          "videoBitrate": "1500k",
          "audioBitrate": "64k"
        },
        {
          "width": 640,
          "height": 360,
          "videoBitrate": "1000k",
          "audioBitrate": "48k"
        },
        {
          "width": 256,
          "height": 144,
          "videoBitrate": "500k",
          "audioBitrate": "48k"
        }
      ]

    }
  },
  "RabbitMQ": {
    "Connection": {
      "HostName": "localhost",
      "UserName": "admin",
      "Password": "admin",
      "Port": "5672"
    },
    "UploadVideoConfig": {
      "ExchangeName": "video-events",
      "VideoProcessQueue": "video-processing",
      "VideoConverterRoutingKey": "video.upload",
      "FileChunksCombinerRoutingKey": "chunks.combine",
      "VideoProcessErrorQueue": "video-processing-error"
    }
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "InstanceName": "VideoView:"
  }

}
