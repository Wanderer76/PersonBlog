{
  "Seq": {
    "OtlpMetricsEndpoint": "http://localhost:5341/ingest/otlp/v1/metrics"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Seq" ],
    "MinimumLevel": "Information",
    "Properties": { "Application": "Conference.API" },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "File", "Args": { "path": "C:\\logs\\PersonBlog\\conference.txt", "rollingInterval": "Day", "retainedFileCountLimit": 7, "shared": true } },
      { "Name": "Seq", "Args": { "serverUrl": "http://localhost:5341" } }
    ]
  },
  "AppUrls": {
    "Auth": "http://localhost:5179/api/"
  },
  "ConnectionStrings": {
    "ConferenceDbContext": "Server=127.0.0.1;Port=5432;Database=person_blog;SearchPath=Conference;User Id=postgres;Password=1;"
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "InstanceName": "VideoView:"
  }
}
