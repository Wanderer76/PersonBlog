{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Seq" ],
    "MinimumLevel": "Information",
    "Properties": { "Application": "AuthGateway.API" },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "File", "Args": { "path": "C:\\logs\\PersonBlog\\auth-gateway.txt", "rollingInterval": "Day", "retainedFileCountLimit": 7, "shared": true } },
      { "Name": "Seq", "Args": { "serverUrl": "http://localhost:5341" } }
    ]
  },
  "AppUrls": {
    "Auth": "http://localhost:5179/api/"
  }
}
