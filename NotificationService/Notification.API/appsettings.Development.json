{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Seq" ],
    "MinimumLevel": "Information",
    "Properties": { "Application": "Notification.API" },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "File", "Args": { "path": "C:\\logs\\PersonBlog\\notification.txt", "rollingInterval": "Day", "retainedFileCountLimit": 7, "shared": true } },
      { "Name": "Seq", "Args": { "serverUrl": "http://localhost:5341" } }
    ]
  },
  "RabbitMQ": {
    "Connection": {
      "HostName": "localhost",
      "UserName": "admin",
      "Password": "admin",
      "Port": "5672"
    }
  },
  "AppUrls": {
    "Auth": "http://localhost:5179/api/",
    "Blog": "http://localhost:7892/profile/",
    "Recommendation": "http://localhost:5209/api/",
    "Reacting": "http://localhost:5153/api/",
    "Search": "http://localhost:5250/api/",
    "Conference": "http://localhost:5193/api/",
    "Comments": "http://localhost:5124/api/"
  }
}
