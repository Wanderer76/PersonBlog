{
  "Seq": {
    "OtlpMetricsEndpoint": "http://localhost:5341/ingest/otlp/v1/metrics"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Seq" ],
    "MinimumLevel": "Information",
    "Properties": { "Application": "Profile.API" },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "C:\\logs\\PersonBlog\\profile.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "shared": true
        }
      },
      {
        "Name": "Seq",
        "Args": { "serverUrl": "http://localhost:5341" }
      }
    ]
  },
  "ConnectionStrings": {
    "ProfileDbContext": "Server=127.0.0.1;Port=5432;Database=person_blog;SearchPath=Profile;User Id=postgres;Password=1;"
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "InstanceName": "VideoView:"
  },
  "RabbitMQ": {
    "Connection": {
      "HostName": "localhost",
      "UserName": "admin",
      "Password": "admin",
      "Port": "5672"
    }
  },
  "FileStorageOptions": {
    "Endpoint": "127.0.0.1:9000", //"http://localhost:9000\"",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin"
  },
  "AppUrls": {
    "Blog": "http://localhost:5069/api/",
    "Auth": "http://localhost:5179/api/"
  }
}
