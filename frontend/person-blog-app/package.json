{
  "name": "person-blog-app",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/blog",
    "packages/admin",
    "packages/shared"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:blog\"",
    "dev:blog": "npm run dev -w=blog",
    "dev:admin": "npm run dev -w=admin",
    "build": "npm run build -w=blog && npm run build -w=admin",
    "build:blog": "npm run build -w=blog",
    "build:admin": "npm run build -w=admin",
    "install:all": "npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "web-vitals": "^4.2.4"
  }
}