{
  "name": "person-blog-app",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/blog",
    "packages/admin",
    "packages/music",
    "packages/auth",
    "packages/shared"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:blog\" \"npm run dev:auth\"",
    "dev:blog": "npm run dev -w=blog",
    "dev:auth": "npm run dev -w=auth",
    "dev:admin": "npm run dev -w=admin",
    "dev:music": "npm run dev -w=music",
    "build": "npm run build -w=blog && npm run build -w=admin",
    "build:blog": "npm run build -w=blog",
    "build:admin": "npm run build -w=admin",
    "build:music": "npm run build -w=music",
    "install:all": "npm install"
  },
  "dependencies": {
    "@tiptap/extension-color": "^3.20.5",
    "@tiptap/extension-image": "^3.20.5",
    "@tiptap/extension-table": "^3.20.5",
    "@tiptap/extension-text-style": "^3.20.5",
    "@tiptap/react": "^3.20.5",
    "@tiptap/starter-kit": "^3.20.5",
    "@types/react-select": "^5.0.1",
    "axios": "^1.7.9",
    "bootstrap": "^5.3.3",
    "cra-template": "1.2.0",
    "hls.js": "^1.5.19",
    "idb": "^8.0.3",
    "react": "^18.0.0",
    "react-beautiful-dnd": "^13.1.1",
    "react-dom": "^18.0.0",
    "react-player": "^2.16.0",
    "react-router-dom": "^7.1.1",
    "react-scripts": "5.0.1",
    "react-select": "^5.10.2",
    "react-signalr": "^0.2.24",
    "video.js": "^8.17.3",
    "videojs-quality-selector-hls": "^1.1.1",
    "videojs-resolution-switcher-v8": "^1.0.12"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "web-vitals": "^4.2.4"
  }
}
