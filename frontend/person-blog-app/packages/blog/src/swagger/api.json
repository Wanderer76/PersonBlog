            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ChangePostPositionRequest": {
        "required": [
          "destination",
          "playlistId",
          "postId"
        ],
        "type": "object",
        "properties": {
          "playlistId": {
            "type": "string",
            "format": "uuid"
          },
          "postId": {
            "type": "string",
            "format": "uuid"
          },
          "destination": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "CommentCreateRequest": {
