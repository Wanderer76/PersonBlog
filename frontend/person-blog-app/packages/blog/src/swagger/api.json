          "text"
        ],
        "type": "object",
        "properties": {
          "postId": {
            "type": "string",
            "format": "uuid"
          },
          "replyTo": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "text": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "CreateMessageForm": {
        "type": "object",
        "properties": {
