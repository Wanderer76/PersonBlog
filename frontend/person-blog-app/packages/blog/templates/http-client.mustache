import API from '../scripts/apiMethod';

export class HttpClient {
  static request<T = unknown>(config: { url: string; method: string; data?: any; params?: any }): Promise<T> {
    switch (config.method.toLowerCase()) {
      case 'get':
        return API.get<T>(config.url, { params: config.params }).then(r => r.data);
      case 'post':
        return API.post<T>(config.url, config.data).then(r => r.data);
      case 'put':
        return API.put<T>(config.url, config.data).then(r => r.data);
      case 'delete':
        return API.delete<T>(config.url).then(r => r.data);
      default:
        throw new Error(`Unsupported method: ${config.method}`);
    }
  }
}